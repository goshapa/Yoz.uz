# --- Общие ---
ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string

# --- PostgreSQL ---
POSTGRES_USER=yoz
POSTGRES_PASSWORD=yoz
POSTGRES_DB=yoz
DATABASE_URL=postgresql+asyncpg://yoz:yoz@postgres:5432/yoz

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- S3 / MinIO ---
S3_ENDPOINT_URL=http://minio:9000
# Пусто = относительный путь, браузер сам подставит текущий хост (Next.js/Caddy
# проксируют /yoz-media/* на MinIO — см. next.config.mjs, Caddyfile).
S3_PUBLIC_URL=
S3_ACCESS_KEY=yozminio
S3_SECRET_KEY=yozminio123
S3_BUCKET=yoz-media
S3_REGION=us-east-1

# --- SMTP (в dev можно оставить как есть — письма пишутся в консоль/лог) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yoz.local

# --- Frontend ---
# Оставить как есть почти всегда: браузер обращается по относительному пути,
# Next.js сам проксирует /api/* на бэкенд (см. API_INTERNAL_URL и next.config.mjs).
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Адреса API и MinIO для проксирования СЕРВЕРОМ Next.js (не для браузера).
# В docker compose — имена сервисов; при запуске web без Docker — localhost.
API_INTERNAL_URL=http://api:8000
MINIO_INTERNAL_URL=http://minio:9000

# Публичный адрес фронтенда — используется бэкендом для CORS и ссылок в письмах
# (сброс пароля). На проде указать реальный домен, например https://yozapp.uz
FRONTEND_BASE_URL=http://localhost:3000

# --- Поддержка (показывается пользователю при ограничении аккаунта) ---
SUPPORT_CONTACT=support@yoz.local
